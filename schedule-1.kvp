Meta.DisplayName=Schedule I
Meta.Description=Schedule I Dedicated Server, powered by the open-source S1DedicatedServers / DedicatedServerMod (https://github.com/ifBars/S1DedicatedServers, GPL-3.0). Requires a Steam account that owns Schedule I. The mod and MelonLoader are fetched automatically from GitHub Releases on every update - no manual downloads required.
Meta.OS=Windows
Meta.Arch=x86_64
Meta.Author=Njordics
Meta.URL=https://github.com/ifBars/S1DedicatedServers
Meta.DisplayImageSource=steam:3164500
Meta.EndpointURIFormat=
Meta.ConfigManifest=schedule-1config.json
Meta.MetaConfigManifest=schedule-1metaconfig.json
Meta.ConfigRoot=schedule-1.kvp
Meta.MinAMPVersion=2.6.0.4
Meta.SpecificDockerImage=
Meta.DockerRequired=False
Meta.ContainerPolicy=SupportedOnWindows
Meta.ContainerPolicyReason=S1DedicatedServers is documented and tested primarily on Windows. The project also publishes an official Docker/Wine image (ghcr.io/ifbars/s1dedicatedservers) for Linux hosting, but that image manages its own SteamCMD/update flow and is not wired into this Generic module template.
Meta.ExtraSetupStepsURI=https://docs.s1servers.com/
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.AppConfigId=9c1e3f2a-6b7d-4e21-8f3a-2d6b7c9a1e50
