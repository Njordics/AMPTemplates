App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=--batchmode --nographics --dedicated-server --stdio-console -logFile - --server-name "{{ServerName}}" --max-players {{$MaxUsers}} --server-password "{{ServerPassword}}" --auth-provider {{AuthProvider}} --auth-timeout {{AuthTimeout}} {{SteamAnonymousLoginFlag}} --steam-gs-token "{{SteamGameServerToken}}" {{ModVerificationFlag}} {{StrictClientModFlag}} --messaging-backend {{MessagingBackend}} --target-framerate {{TargetFramerate}} --vsync {{VSyncCount}} {{DebugModeFlag}} {{VerboseFlag}} {{TcpConsoleFlag}} --tcp-console-port {{TcpConsolePort}} --tcp-console-bind "{{TcpConsoleBind}}" --tcp-console-password "{{TcpConsolePassword}}" {{CustomArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"SteamAppId":"3164500"}
App.CommandLineParameterFormat=--{0} "{1}"
App.CommandLineParameterDelimiter= 
