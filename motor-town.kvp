Meta.DisplayName=Motor Town: Behind The Wheel
Meta.Description=Motor Town: Behind The Wheel Dedicated Server
Meta.OS=Windows, Linux
Meta.Arch=x86_64
Meta.Author=AMP Community
Meta.URL=https://store.steampowered.com/app/1369670/Motor_Town_Behind_The_Wheel/
Meta.DisplayImageSource=steam:1369670
Meta.EndpointURIFormat=
Meta.ConfigManifest=motor-townconfig.json
Meta.ConfigRoot=motor-town.kvp
Meta.MinAMPVersion=2.6.0.4
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=False
Meta.ContainerPolicy=SupportedOnWindows, RecommendedOnLinux
Meta.ContainerPolicyReason=The dedicated server is a Windows application. On Linux this template runs it directly with Wine, without Proton.
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=2
Meta.AppConfigId=5b32e12f-f70a-4c2b-a756-82ed5bfc083b
App.DisplayName=Motor Town: Behind The Wheel
App.RootDir=./motortown/
App.BaseDirectory=./motortown/2223650/
App.ExecutableWin={{ServerExecutable}}
App.ExecutableLinux=/usr/bin/xvfb-run
App.WorkingDir=2223650
App.LinuxCommandLineArgs=-a wine "{{ServerExecutable}}"
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}} {{CustomArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"SteamAppId":"1369670","WINEPREFIX":"{{$FullRootDir}}.wine","WINEARCH":"win64","WINEDEBUG":"-all"}
App.CommandLineParameterFormat=-{0} "{1}"
App.CommandLineParameterDelimiter= 
App.ExitMethod=OS_CLOSE
App.ExitMethodWindows=CtrlC
App.ExitTimeout=30
App.ExitString=quit
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[motor-townports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=GamePort
App.UniversalSleepApplicationUDPPortRef=GamePort
App.UniversalSleepSteamQueryPortRef=QueryPort
App.MaxUsers=100
App.UseRandomAdminPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.AdminLoginTransform=None
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=
App.TelnetLoginFormat=login {0}
App.UpdateSources=@IncludeJson[motor-townupdates.json]
App.Compatibility=None
App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=True
App.RapidStartup=False
App.MonitorChildProcessName=
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^.*(wine:.*|fixme:.*|err:.*|X connection to .* broken).*$
Console.AppReadyRegex=^.*(Server started|Server is running|Listening on).*$
Console.UserJoinRegex=^
Console.UserLeaveRegex=^
Console.UserChatRegex=^
Console.UpdateAvailableRegex=^
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25